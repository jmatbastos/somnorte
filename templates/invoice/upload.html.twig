{% extends 'base.html.twig' %}

{% block title %}Upload{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact.css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles') }}/contact_responsive.css">
{% endblock %}

{% block body %}
<div class="container">
    <div class="row row-xl-eq-height">
        <div class="col-xl-3">
        </div>					
        <!-- Contact Content -->
        <div class="col-xl-6">
            <div class="contact_content">
                <div class="contact_form_container">

                    <h3 style="text-align: center">Invoice upload</h3>                
                
                    {% if errors > 0 %}
                        <h2>Validation failed</h2>
                        <ul>
                        {% for field, errorMessage in errorMessages %}
                            <li>{{ errorMessage }}</li>
                        {% endfor %}
                        </ul>
                        <br>
                        {% endif %}
                
                
                    <form enctype="multipart/form-data" method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token('file') }}">


                        <div class="form-group">
                            <label >Type</label>
                            <select name="type" class="form-control">
                                <option value="Invoice">Invoice</option>
                                <option value="Invoice/Receipt">Invoice/Receipt</option>
                                <option value="Receipt">Receipt</option> 
                            </select>
                        </div>								
                        <br> 

                        <div class="form-group">
                            <label >Reference</label>
                            <input type="text" class="form-control" name="reference" />
                        </div>								
                        <br>  

                        <div class="form-group">
                            <label >Value (in Euros)</label>
                            <input type="number" class="form-control" name="value"  step="0.01" />
                        </div>								
                        <br>                         

                        <div class="form-group">
                            <label >Date</label>
                            <input type="date" class="form-control" name="date" />
                        </div>								
                        <br> 

                                            
                        <div class="form-group">
                            <br>
                            <input type="file" class="form-control" id="fileUpload" name="file" />
                        </div>								
                        <br>

                        <div>
                        <p>Before uploading, check out the <a href="#" onmouseover="popUP()">file upload restrictions</a>.</p>
                        </div>

                        <br>
                        
                        <a href="{{ path('cachets_show') }}" class="btn btn-outline-warning btn-lg" >Cancel</a>								
                        <button type="submit" class="btn btn-outline-primary btn-lg float-right">Upload</button>
                    
                    </form>
                </div>

            </div>
        </div>
        <div class="col-xl-3">
        </div>	
    </div>
</div>            
{% endblock %}
{% block javascript %}
    {{ parent() }}

    <script>
        function popUP() {
        window.alert("file upload restrictions: \n- allowed file types: pdf\n- maximum size: 10 MB\n\n");
        }
    </script>

{% endblock %}
